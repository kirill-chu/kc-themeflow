# kc-themeflow — Dunst theme template.
#
# AUTO-GENERATED on every theme change. Do not edit by hand.
# Adjust the reference at config/templates/dunst-theme.dunstrc in the
# project, then re-run kc-themeflow.
#
# Rendered by pywal16 into ~/.cache/wal/dunst-theme.dunstrc,
# then copied to ~/.config/dunst/dunstrc.
#
# See dunst(5) for all configuration options.

[global]
    ### Display ###
    monitor = 0
    follow = mouse

    ### Geometry ###
    width = 300
    height = (0, 300)
    origin = top-right
    offset = (8, 32)
    scale = 0
    notification_limit = 20

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 0
    progress_bar_corners = all
    icon_corner_radius = 0
    icon_corners = all
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 2
    horizontal_padding = 2
    text_icon_padding = 0
    frame_width = 2

    # kc-themeflow: frame color comes from the active palette.
    frame_color = "{color5}"

    gap_size = 0
    separator_color = frame
    sort = yes

    ### Text ###
    font = "UbuntuMono Nerd Font Mono"
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = breeze-dark, Adwaita, hicolor
    icon_position = left
    min_icon_size = 32
    max_icon_size = 128
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/

    ### History ###
    sticky_history = yes
    history_length = 20

    ### Misc/Advanced ###
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 8
    corners = all
    ignore_dbusclose = false

    ### Wayland ###
    force_xwayland = false

    ### Legacy
    force_xinerama = false

    ### mouse
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    # kc-themeflow: colors come from the active palette.
    background = "{background}"
    foreground = "{color2}"
    frame_color = "{color2}"
    timeout = 60
    override_pause_level = 30
    default_icon = dialog-information

[urgency_normal]
    background = "{background}"
    foreground = "{color5}"
    timeout = 300
    override_pause_level = 60
    default_icon = dialog-information

[urgency_critical]
    background = "{background}"
    foreground = "{color1}"
    frame_color = "{color1}"
    timeout = 0
    override_pause_level = 60
    default_icon = dialog-warning
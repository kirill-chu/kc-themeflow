/**
 * kc-themeflow — Rofi theme template.
 *
 * AUTO-GENERATED on every theme change. Do not edit by hand.
 * Adjust the reference at config/templates/rofi-theme.rasi in the
 * project, then re-run kc-themeflow.
 *
 * Rendered by pywal16 into ~/.cache/wal/rofi-theme.rasi,
 * then copied to ~/.config/rofi/current-theme.rasi.
 *
 * NOTE: pywal renders templates with Python str.format(). Literal
 * braces must be doubled; placeholders like {background} and {color4}
 * stay single. If you add new rules, keep this in mind — otherwise
 * pywal fails with KeyError.
 */

* {{
    bg0: {background};
    fg0: {foreground};

    bg1: {color0};
    fg1: {color7};

    grey0: {color8};

    /* Accent color — matches the active group in Qtile and selections
       in Alacritty. See docs/themes.md, "Accent color". */
    selbg0: {color4};
    selfg0: {background};

    blue: {color4};
    red: {color1};
    orange: {color3};
    green: {color2};
    bgStatusline3: {color8};

    background-color: @bg0;

    window-border-color: {color5};
}}

window {{
    height: 600;
    width: 600;

    border: 1;
    border-radius: 10;
    border-color: @window-border-color;
}}

mainbox {{
    spacing: 0;
    children: [inputbar, message, listview];
}}

inputbar {{
    color: @fg0;
    padding: 14;
    background-color: @bg1;
    border: 0;
    border-color: @window-border-color;
    border-radius: 0;
}}

message {{
    padding: 10;
    background-color: @grey0;
}}

listview {{
    padding: 8;
    border-radius: 0 0 10 10;
    border: 2 2 2 2;
    border-color: @bg0;
    background-color: @bg0;
    dynamic: false;
}}

textbox {{
    text-color: @fg0;
    background-color: inherit;
}}

error-message {{
    border: 20 20 20 20;
}}

entry {{
    placeholder: "filter...";
    placeholder-color: @grey0;
}}

entry, prompt, case-indicator {{
    text-color: inherit;
    background-color: @bg1;
}}

prompt {{
    margin: 0 10 0 0;
    text-color: @orange;
}}

element {{
    padding: 5;
    vertical-align: 0.5;
    border-radius: 10;
    background-color: @bg0;
}}

element.selected.normal {{
    background-color: @selbg0;
}}

element-text.selected.normal {{
    text-color: @selfg0;
}}

element.alternate.normal {{
    background-color: inherit;
}}

element.normal.active, element.alternate.active {{
    background-color: @orange;
}}

element.selected.active {{
    background-color: @green;
}}

element.normal.urgent, element.alternate.urgent {{
    background-color: @red;
}}

element.selected.urgent {{
    background-color: @blue;
}}

element-text, element-icon {{
    size: 36;
    margin: 0 10 0 0;
    vertical-align: 0.5;
    background-color: inherit;
    text-color: @fg0;
}}

element-text .active, element-text .urgent {{
    text-color: @bg0;
}}